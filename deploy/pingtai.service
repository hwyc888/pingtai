[Unit]
Description=pingtai Go platform
After=network.target
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/pingtai
EnvironmentFile=-/etc/pingtai.env
StateDirectory=pingtai
StateDirectoryMode=0700
Environment=PINGTAI_CONFIG_FILE=/var/lib/pingtai/pingtai-config.json
Environment=PINGTAI_DB_PATH=/var/lib/pingtai/pingtai.db
ExecStart=/opt/pingtai/pingtai-linux-amd64
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
