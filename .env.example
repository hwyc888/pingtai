# Copy this file to .env next to the executable.
# The frontend is embedded in the EXE; WEB_DIR is optional and only overrides it with an external directory.
HTTP_ADDR=:5050
MAX_UPLOAD_MB=100

# SQLite is created automatically; no database server is required.
AUTH_MODE=local
PINGTAI_DB_PATH=./data/pingtai.db

# Generate a random secret of at least 32 characters.
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# School unified identity authentication (OAuth2 authorization-code flow).
# Register this exact callback URL in the school's SSO management console.
SSO_BASE_URL=https://ids.zcvc.cn/cas
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=
# One or more SSO account identifiers with platform administrator permissions.
SSO_ADMIN_ACCOUNTS=

CHAT_PROVIDER=openai
# This platform's client-facing key; do not confuse it with the upstream API key.
MODEL_API_KEY=

# Generic OpenAI Chat Completions compatible upstream.
# Base URL accepts a custom API prefix or the full /chat/completions endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional comma-separated web-chat model choices; include OPENAI_MODEL when set.
OPENAI_MODELS=
OPENAI_TIMEOUT_SECONDS=180
# Web chat only: 0 lets the upstream choose its output limit.
OPENAI_MAX_TOKENS=0
OPENAI_SYSTEM_PROMPT=
# Web chat history: complete successful turns; 0 means all stored turns.
CONTEXT_TURNS=20

# Legacy CTYun mode (CHAT_PROVIDER=ctyun).
CTYUN_AUTH_MODE=bearer
CTYUN_API_URL=
CTYUN_API_KEY=
CTYUN_MODEL=
CTYUN_MAX_COMPLETION_TOKENS=1024
CTYUN_TIMEOUT_SECONDS=180
CTYUN_SYSTEM_PROMPT=

# Optional Coze credentials for agent publishing and knowledge-base management.
COZE_BASE_URL=https://api.coze.cn
COZE_APP_ID=
COZE_PUBLIC_KEY_ID=
COZE_PRIVATE_KEY_FILE=
COZE_ACCESS_TOKEN=
COZE_WORKSPACE_ID=7481824441182617636

# For Star MaaS signature mode, set CTYUN_AUTH_MODE=signature and fill:
# CTYUN_APP_ID=
# CTYUN_APP_KEY=
# CTYUN_REGION=QG
# CTYUN_SIGN_PREFIX=teleai-cloud-auth-v1
# CTYUN_ORDER_NUM=
# CTYUN_KNOWLEDGE_BASE=
