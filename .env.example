# Optional service-level settings. AI providers and model credentials are managed in /admin.
HTTP_ADDR=:5050
MAX_UPLOAD_MB=100
PINGTAI_DB_PATH=./data/pingtai.db
CONTEXT_TURNS=20

# Optional key for external clients calling this platform's OpenAI-compatible API.
MODEL_API_KEY=

# Optional legacy import on first launch only. Prefer adding providers in the platform UI.
